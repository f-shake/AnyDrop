<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AnyDrop.Server</RootNamespace>
    <AssemblyName>AnyDrop.Server</AssemblyName>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <!-- 文件日志只装这三件。刻意**不**装 Serilog.AspNetCore：它会传递带入
         Serilog.Settings.Configuration + Microsoft.Extensions.DependencyModel（反射式配置，
         AOT 运行期无官方声明），而且它的 UseSerilogRequestLogging 默认把 {RequestPath} 写进日志
         —— 本项目的下载 id 就在 path 里，那是凭证。
         ⚠ 接线写法见 Program.cs：必须是 "注册一个 ILoggerProvider 交给容器托管"，
         **不要**用 Logging.AddSerilog(...) —— 实测那样加进来的 provider 不受 MS 级别过滤器约束，
         于是 Logging:LogLevel（含 ANYDROP__Logging__LogLevel__*）会整体失效、逐请求日志会带着 id 落盘。 -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 下载页与兜底页跟着程序走，不依赖运行目录 -->
    <EmbeddedResource Include="Pages\download.html" LogicalName="page/download.html" />
    <EmbeddedResource Include="Pages\ui-not-built.html" LogicalName="page/ui-not-built.html" />
    <!-- 前端产物只以“内嵌资源”形式进程序，不再作为静态内容重复发布 -->
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 纯自托管，不需要 IIS 相关产物 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <!-- 由 scripts/build-web.ps1 生成：把前端 dist 作为内嵌资源登记进来（带确定性 LogicalName）。 -->
  <Import Project="wwwroot.g.props" Condition="Exists('wwwroot.g.props')" />

</Project>
